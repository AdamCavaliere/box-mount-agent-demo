# Copy to .env.databricks (git-ignored). Only the coordinator's sandbox (sandbox-coordinator) loads
# it: the agents' sandboxes never see these credentials. Leave it out and the coordinator skips its
# Databricks steps.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# A personal access token, or a service principal (preferred: grant it only the schema below).
DATABRICKS_TOKEN=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# SQL Warehouses > your warehouse > Overview: the ID at the end of the "Name" line
DATABRICKS_WAREHOUSE_ID=
# Where `just databricks seed` creates ap_invoices and review_findings
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=box_relay
