# Copy to .env. Never commit .env or secrets/.
BOX_FOLDER_ID=
# JWT (recommended): put the app's JSON config at secrets/box-jwt-config.json
BOX_AUTH_TYPE=jwt
BOX_JWT_CONFIG_PATH=/home/boxsvc/.box-mount/box-jwt-config.json  # `just up` copies secrets/box-jwt-config.json here
# Or, for a quick spike only (expires in 60 min, sync stops), comment out the two lines above and set:
# BOX_ACCESS_TOKEN=
# Booth demo (Box Relay): a small separate folder, e.g. a Booth/ subfolder
BOOTH_BOX_FOLDER_ID=
