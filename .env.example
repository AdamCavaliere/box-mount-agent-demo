# Copy to .env. Never commit .env or secrets/.
# Box JWT app (required): put its JSON config at secrets/box-jwt-config.json
BOX_AUTH_TYPE=jwt
BOX_JWT_CONFIG_PATH=/home/boxsvc/.box-mount/box-jwt-config.json  # `just up` copies secrets/box-jwt-config.json here
# The demo's Box folder (the number at the end of its Box URL)
DEMO_BOX_FOLDER_ID=
# Written by `just setup`: the Extractor's and the Reviewer's own folders inside it
DEMO_EXTRACTION_FOLDER_ID=
DEMO_REVIEW_FOLDER_ID=
